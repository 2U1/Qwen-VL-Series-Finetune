    "version": "0.2.0",
    "configurations": [
      {
          "name": "Python Debugger: Current File with Arguments",
          "type": "debugpy",
          "request": "launch",
          "program": "${file}",
          "console": "integratedTerminal",
          "args": "${command:pickArgs}"
      },
      {
          "name": "Debug: prepare_mind2web_data.py",
          "type": "debugpy",
          "request": "launch",
          "program": "${workspaceFolder}/src/prepare_mind2web_data.py",
          "console": "integratedTerminal",
          "args": [
              "${env:HOME}/Downloads/test_splits",
              "original"
          ],
          "cwd": "${workspaceFolder}"
      },
      {
        "name": "List presets",
        "type": "debugpy",
        "request": "launch",
        "module": "eval.gui_perturbed_evaluator",
        "console": "integratedTerminal",
        "python": "${workspaceFolder}/.venv/bin/python",
        "env": {
          "PYTHONPATH": "${workspaceFolder}",
          "DEBUG": "True"
        },
        "cwd": "${workspaceFolder}",
        "justMyCode": true,
        "args": [
          "--csv_path",
          "variant_data_cleaned.csv",
          "--screenshots_base_dir",
          "/mnt/test_splits/",
          "--output_dir",
          "/mnt/baseline_results/",
          "--list_presets"
        ]
      },
      {
